# Environment Configuration for AR Events Co.
# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="AR Events Co."
APP_TAGLINE="Your Celebration, Our Passion"
SUPPORT_PHONE="+92 300 1234567"
SUPPORT_EMAIL="info@areventsco.com"
SERVICE_CITIES="Islamabad, Rawalpindi"

# Database (PostgreSQL or local SQLite for development)
DATABASE_URL="file:./dev.db"

# Authentication
AUTH_SECRET="development-secret-key-replace-in-production-areventsco"
AUTH_EXPIRES_IN="7d"

# Storage Provider (Decoupled Provider: S3 / Cloudflare R2 / Local)
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="arevents-media"

# Transactional Email Provider (Decoupled Provider: Resend / SendGrid / Console Mock)
EMAIL_PROVIDER="mock"
EMAIL_PROVIDER_KEY=""
EMAIL_FROM="AR Events Co. <no-reply@areventsco.com>"

# Payment Provider (Decoupled Provider: Safepay / PayFast / Manual Bank Transfer / Mock)
PAYMENT_PROVIDER="mock"
PAYMENT_PROVIDER_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# WhatsApp Notification Provider (Decoupled Provider: Twilio / Meta Cloud API / Mock)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""
